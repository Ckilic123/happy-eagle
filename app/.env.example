# Copy to .env.local and fill in. .env.local is git-ignored.
# These are CLIENT-SIDE values (safe to ship): the anon key is public by design,
# protected by Row Level Security. Do NOT put the Claude key (or any server secret)
# here — it lives server-side in the Supabase Edge Function (secrets), never in the app.
# (Background removal runs on-device, so it needs no key.)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
